---
import MainH3 from "../../../components/MainH3.astro";
import { defaultLang } from "../../../i18n/ui";

const lang = Astro.cookies.get("lang")?.value || defaultLang;
---

<div class="flex flex-col">
    <div class="overflow-hidden rounded-xl border border-black/[0.06] dark:border-white/[0.08]">
        <img
            src="/inelar.avif"
            alt={lang === "es" ? "Imagen del proyecto Front Inelar" : "Image of the Front Inelar project"}
            title={lang === "es" ? "Imagen del proyecto Front Inelar" : "Image of the Front Inelar project"}
            width="500"
            height="auto"
            class="w-full aspect-[16/10] object-cover transition-all duration-500 group-hover:scale-[1.02] group-hover:opacity-[0.96]"
            id="projectInelarImage"
        />
    </div>
    <div class="pt-4 flex flex-col">
        <MainH3 title="projects.titleInelar" />
        <p class="font-montserrat text-zinc-600 dark:text-zinc-400 text-sm mt-2 leading-relaxed line-clamp-3" data-i18n="projects.description"></p>
        <div class="flex flex-wrap items-center gap-x-2 mt-3 text-[11px] tracking-widest uppercase text-zinc-400 dark:text-zinc-500 font-montserrat">
            <span>NextJs</span><span class="opacity-30">·</span><span>NodeJs</span><span class="opacity-30">·</span><span>MongoDB</span>
        </div>
        <div class="flex items-center gap-3 mt-4">
            <a href="https://inelar.vercel.app/" target="_blank" rel="noopener noreferrer"
                aria-label={lang === "es" ? "Abrir proyecto Inelar" : "Open Inelar project"}
                title={lang === "es" ? "Abrir proyecto Inelar" : "Open Inelar project"}
                class="inline-flex items-center gap-1 text-sm font-montserrat text-zinc-900 dark:text-zinc-100 underline underline-offset-4 decoration-zinc-300 dark:decoration-zinc-600 hover:decoration-zinc-900 dark:hover:decoration-white transition-colors">
                Ver proyecto <span aria-hidden="true">→</span>
            </a>
            <a href="https://github.com/juancruzleone/InelarWeb" target="_blank" rel="noopener noreferrer"
                aria-label={lang === "es" ? "Abrir repositorio del proyecto en Github" : "Open repository GitHub of project"}
                title={lang === "es" ? "Abrir repositorio del proyecto en Github" : "Open repository GitHub of project"}
                class="text-xs font-montserrat text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">
                GitHub
            </a>
        </div>
    </div>
</div>
<script>
    function updateImageAttributes() {
        const lang = localStorage.getItem("lang") || "es";
        const el = document.getElementById("projectInelarImage") as HTMLImageElement;
        if (el) {
            el.alt = lang === "es" ? "Imagen del proyecto Front Inelar" : "Image of the Front Inelar project";
            el.title = lang === "es" ? "Imagen del proyecto Front Inelar" : "Image of the Front Inelar project";
        }
    }
    updateImageAttributes();
    window.addEventListener("storage", (e) => { if (e.key === "lang") updateImageAttributes(); });
    document.addEventListener("astro:language-changed", updateImageAttributes);
    const observer = new MutationObserver(updateImageAttributes);
    observer.observe(document.body, { childList: true, subtree: true });
</script>
